        "keywords": [ "BACnet", "BACIP", "IO", "数据传输", "控制", "BACnet/IP", "模拟输入", "模拟输出", "模拟值", "二进制输入", "二进制输出", "二进制值", "多状态输入", "多状态输出", "多状态值", "设备号", "对象地址", "写优先级", "转换", "比例系数", "楼宇自动化", "工业控制", "集成"],
        "usage_guides": [],
        "parameters_schema": {
            "user_defined_name": {
            "type": "string",
            "description": "该模块的名称",
            "default": "BACIP IO"
            },
            "bacnetIpDeviceInstance": {
            "type": "integer",
            "description": "设备句柄号",
            "minimum":0,
            "maximun":4194303,
            "default": 0
            },
            "inputCount": {
            "type": "integer",
            "description": "输入端口数量",
            "minimum": 1,
            "maximum": 2,
            "default": 1
            }
            

        },

        "ports_definition": {
            "inputs":[
                {
                    "index": 0,
                    "label":"输入",
                    "type":"number",
                    "description":"实例目标赋值",
                    "condition":"always"
                },
                {
                    "index": 1,
                    "label":"使能输入",
                    "type":"integer",
                    "description":"使能控制实例对象的赋值;为0时,输入值不赋值至输出;为1或非0数值,把输入的值赋值至输出;端口未连接按1处理",
                    "condition":"always"
                }

            ],
            "outputs":[
                {
                    "index": 0,
                    "label":"输出",
                    "type":"number",
                    "description":"实例的值;对象类型为Binary***时,输出为布尔值;对象类型为Analog ***时,输出为数值;对象类型为Multi-state***时,输出为整型数值",
                    "condition":"always"

                }
            ]

        },

