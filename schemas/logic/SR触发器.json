{
  "id": "",
  "module_type": "srFlipflop",
  "category": "逻辑模块/触发器",
  "name": "SR触发器 (SR Flip-Flop)",
  "description": "SR触发器模块用于实现基本的置位/复位触发逻辑。SR触发器即复位优先触发器。",
  "keywords": [
    "触发器",
    "SR",
    "置位复位",
    "状态保持",
    "逻辑",
    "复位优先"
  ],
  "usage_guides": [
    "SR触发器即复位优先触发器。",
    "当复位为True(1)时，输出保持False(0)。",
    "当输入为False(0)，复位为False(0)时，输出保持上一刻状态不变。",
    "当输入为True(1)，复位为False(0)时，输出复位为True(1)。"
  ],
  "parameters_schema": {
    "user_defined_name": {
      "type": "string",
      "description": "模块显示名称，由用户根据实际应用场景定义。",
      "default": "SR触发器"
    }
  },
  "ports_definition": {
    "inputs": [
      {
        "index": 0,
        "type": "boolean",
        "description": "置位信号。",
        "label": "输入",
        "condition": "always"
      },
      {
        "index": 1,
        "type": "boolean",
        "description": "复位信号。",
        "label": "复位",
        "condition": "always"
      }
    ],
    "outputs": [
      {
        "index": 0,
        "type": "boolean",
        "description": "输出结果。",
        "label": "输出",
        "condition": "always"
      }
    ]
  },
  "template_json": {
    "id": "{{__GEN_ID__}}",
    "z": "{{__FLOW_ID__}}",
    "type": "srFlipflop",
    "name": "{{user_defined_name}}",
    "inputs": 2,
    "outputs": 1,
    "outOfService": 0,
    "outOfServiceValue": 0,
    "x": "{{__POS_X__}}",
    "y": "{{__POS_Y__}}",
    "wires": [
      [],
      []
    ]
  }
}
